package application;

import java.time.Instant;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;

public class program {

	public static void main(String[] args) {
		// https://docs.oracle.com/en/java/javase/25/docs/api/java.base/java/time/format/DateTimeFormatter.html
		
		LocalDate date03  = LocalDate.parse("2026-01-31");
		LocalDateTime date04 = LocalDateTime.parse("2026-01-31T18:00:26");
		Instant date05 = Instant.parse("2026-01-31T18:00:26Z");
		
		DateTimeFormatter fmt1 = DateTimeFormatter.ofPattern("dd/MM/yyyy");
		DateTimeFormatter fmt2 = DateTimeFormatter.ofPattern("dd/MM/yyyy" + "as" + "HH:mm");
		
		//ISO 8601 para customizavel
		System.out.println("date 03 = " + date03.format(fmt1));
		// ou
		System.out.println("date 03 = " + fmt1.format(date03));
		System.out.println("date 04 = " + date04.format(fmt2));
	}

}
